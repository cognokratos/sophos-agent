# Local development (`pnpm dev`). Copy to .env.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_THINK=true
SHOW_TOOLS=true
# Directory containing mcp.json and system.md
CONFIG_DIR=config
# Conversation transcripts (Markdown + trace.jsonl)
CHAT_DIR=data/chat
# Knowledge graph of the stdio Memory MCP server; substituted for ${MEMORY_FILE_PATH} in config/mcp.json
MEMORY_FILE_PATH=data/memory/memory.jsonl
